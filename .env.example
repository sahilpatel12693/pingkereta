# PingKereta — example only. Do not put live secrets in GitHub.
# Configure secrets in the independent Netlify site settings, not in this file.
# Both flags MUST remain false during the domain migration.
PINGKERETA_ENABLE_LIVE=false
PINGKERETA_RELEASE_APPROVED=false

# Only for an authorised, security-reviewed future controlled pilot.
# WhatsApp/Twilio settings further below are OPTIONAL and are NOT required for Web Push.
# Generate secure random values locally; never paste them into chat or issues.
# Free browser push — the primary notification channel for controlled pilots.
# Generate your ONE permanent VAPID key pair using: npm install && npm run vapid
# VAPID public key is safe to share with browsers; private key must stay secret.
# Important: retain the same key pair between deploys or existing subscriptions break.
PINGKERETA_VAPID_PUBLIC_KEY=
PINGKERETA_VAPID_PRIVATE_KEY=
PINGKERETA_VAPID_SUBJECT=mailto:YOUR-REAL-CONTACT-EMAIL

PINGKERETA_PILOT_INVITE_SECRET=
PINGKERETA_DATA_ENCRYPTION_KEY=
PINGKERETA_TWILIO_ACCOUNT_SID=
PINGKERETA_TWILIO_AUTH_TOKEN=
PINGKERETA_TWILIO_VERIFY_SERVICE_SID=
PINGKERETA_TWILIO_WHATSAPP_FROM=
PINGKERETA_WHATSAPP_CONTENT_SID=
PINGKERETA_TWILIO_STATUS_URL=https://pingkereta.com/api/pingkereta/twilio-status

# Optional SMS fallback / legacy Telegram connection, not required for preview.
PINGKERETA_TWILIO_FROM=
PINGKERETA_TELEGRAM_BOT_TOKEN=
PINGKERETA_WEBHOOK_SECRET=
PINGKERETA_BOT_USERNAME=
